# Copy to .env — never commit real values here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Just the id from https://formspree.io/f/<id>, not the whole URL.
VITE_FORMSPREE_FORM_ID=
# Cloudflare Turnstile site key. Add "localhost" to the widget's allowed
# hostnames or it fails with error 110200 in local dev.
VITE_TURNSTILE_SITE_KEY=
# The map is Leaflet + OpenStreetMap tiles: no key, no billing, no quota.
